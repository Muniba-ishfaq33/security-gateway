PORT=5000
NODE_ENV=development

# URL of this app (no trailing slash). Local: http://localhost:5000
BASE_URL=http://localhost:5000
# Extra allowed origins for CORS (comma separated). Optional.
CLIENT_ORIGIN=

# --- MySQL (Laragon default) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=security_gateway
# On Railway just set MYSQL_URL (it overrides DB_* above)
# MYSQL_URL=

# --- JWT secrets (use long random strings) ---
JWT_ACCESS_SECRET=change_me_access_secret_very_long_random
JWT_REFRESH_SECRET=change_me_refresh_secret_very_long_random

# --- OAuth (fill at least one) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
